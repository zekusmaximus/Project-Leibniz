# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored and must never be committed.

# MongoDB connection string (e.g. a MongoDB Atlas SRV URI). Required.
MONGODB_URI=your_mongodb_connection_string_here

# Port the Express server listens on.
PORT=3001

# Node environment: "development" (default) or "production".
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (CORS allow-list).
# In development this defaults to the Vite dev/preview origins if left unset.
# In production, set this explicitly (unless the API only serves the bundled
# same-origin client, in which case no value is needed).
CLIENT_ORIGINS=http://localhost:5173
